+internal suspend fun runRemoteJob(
+    identity: RemoteIdentity, job: JSONObject, manifest: JSONObject, snapshot: RemoteCatalogInput,
+    settings: SettingsStore, vault: CredentialVault, profileTransfer: TvProfileTransfer,
+    customization: PlaylistCustomizationStore, restored: () -> Unit, playlistsChanged: () -> Unit,
+): JSONObject? {
+    val id = UUID.fromString(job.getString("id")).toString()
+    val payload = job.getJSONObject("payload")
+    val phase = job.getString("kind")
+    val binding = snapshot.binding
+    val ok = JSONObject().put("ok",true)
+    val fail = JSONObject().put("ok",false)
+    val receiptKey = "remote_applied:${snapshot.profile.id}"
+    if (phase == "layout" || phase == "playlist") {
+        if (vault.loadIntegrationSecret(receiptKey) == id) return ok
+        if (job.getString("context") != manifest.getString("context")) return fail
+    }
+    return when (phase) {
+        "backup" -> {
+            val requested = payload.optString("playlist").takeIf { !payload.isNull("playlist") }
+            if (requested != null && requested != binding?.playlist) return fail
+            applyTvSettingsCommand(JSONObject().put("id",id).put("phase","capture")
+                .put("scope",if (requested == null) "settings" else "profile")
+                .put("playlist",binding?.playlist).put("viewer",binding?.viewer),
+                settings,listOf(snapshot.profile.id),binding,profileTransfer,restored)
+        }
+        "restore" -> {
+            val profile = payload.optJSONObject("profile")
+            if (profile != null && profile.getString("playlist") != binding?.playlist) return fail
+            applyTvSettingsCommand(JSONObject().put("id",id).put("phase","apply")
+                .put("settings",payload.getJSONObject("settings")).put("profile",profile)
+                .put("scope",if (profile == null) "settings" else "profile")
+                .put("playlist",binding?.playlist).put("viewer",binding?.viewer),
+                settings,listOf(snapshot.profile.id),binding,profileTransfer,restored)
+        }
+        "layout" -> {
+            if (binding == null || binding.playlist != payload.getString("playlist") || !manifest.getBoolean("layoutComplete")) return fail
+            val layout = payload.getJSONObject("layout")
+            val groupArray = layout.getJSONArray("groups")
+            val groups = List(groupArray.length()) { idx -> groupArray.getJSONObject(idx).let { group ->
+                val channels = group.getJSONArray("channels")
+                CustomChannelGroup(group.getString("id"),group.getString("name"),
+                    List(channels.length()) { channels.getString(it) },pinned=group.getBoolean("pinned"))
+            } }
+            require(groups.size <= 80 && groups.map { it.id }.toSet().size == groups.size &&
+                groups.all { groupId.matches(it.id) && it.name.length in 1..80 && it.channelIds.size <= 2000 && it.channelIds.all(stable::matches) })
+            val visible = layout.optJSONArray("visible")?.let { array -> List(array.length()) { array.getString(it) }.toSet() }
+            val categories = snapshot.catalog?.categories.orEmpty().mapTo(hashSetOf()) { it.storageKey() }
+            require(visible?.all { it in categories } != false)
+            withContext(NonCancellable) {
+                if (!withContext(Dispatchers.IO) {
+                    customization.replaceForBackup(binding.scope,groups,visible).also {
+                        if (it) vault.persistRemoteIdentity(receiptKey,id)
+                    }
+                }) null else { restored();ok }
+            }
+        }
+        "playlist" -> {
+            if (BuildConfig.BETA_ACCESS_ENABLED) return fail
+            val target = payload.optString("playlist").takeIf { !payload.isNull("playlist") }
+            val name = payload.getString("name").trim()
+            if (name.length !in 1..80) return fail
+            val updated = withContext(NonCancellable + Dispatchers.IO) {
+                val url = payload.optJSONObject("sealed")?.let(identity::open)
+                vault.applyRemotePlaylist(snapshot.profile.id,target,name,url,receiptKey,id)
+            }
+            if (updated) { playlistsChanged(); ok } else fail
+        }
+        else -> fail
+    }
+}
