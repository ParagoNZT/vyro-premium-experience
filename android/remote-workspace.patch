+private val stable = Regex("[a-zA-Z0-9_.:-]{1,128}")
+private val groupId = Regex("group-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}")
+private val proofFormat = Regex("[A-F0-9]{32}")
+private fun hex(value: ByteArray) = value.joinToString("") { "%02x".format(it.toInt() and 255) }
+private fun hash(value: String) = hex(MessageDigest.getInstance("SHA-256").digest(value.toByteArray(Charsets.UTF_8)))
+private fun b64(value: ByteArray) = Base64.encodeToString(value, Base64.NO_WRAP)
+private fun unb64(value: String) = Base64.decode(value, Base64.NO_WRAP)
