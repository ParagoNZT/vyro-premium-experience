+internal class RemoteIdentity(val id: String, val token: String, val publicKey: String, private val privateKey: String) {
+    companion object {
+        fun load(vault: CredentialVault, profileId: String, create: Boolean = false): RemoteIdentity? {
+            val key = "remote_device:$profileId"
+            val stored = vault.readIntegrationSecretStrict(key)
+            if (!stored.isNullOrEmpty()) {
+                val obj = JSONObject(stored)
+                return RemoteIdentity(obj.getString("id"),obj.getString("token"),obj.getString("publicKey"),obj.getString("privateKey"))
+            }
+            if (!create) return null
+            val keys = KeyPairGenerator.getInstance("RSA").apply { initialize(2048) }.generateKeyPair()
+            val identity = RemoteIdentity(UUID.randomUUID().toString(),hex(ByteArray(32).also(SecureRandom()::nextBytes)),
+                b64(keys.public.encoded),b64(keys.private.encoded))
+            vault.persistRemoteIdentity(key, JSONObject().put("id",identity.id).put("token",identity.token)
+                .put("publicKey",identity.publicKey).put("privateKey",identity.privateKey).toString())
+            return identity
+        }
+    }
+
+    fun open(envelope: JSONObject): String {
+        val private = KeyFactory.getInstance("RSA").generatePrivate(PKCS8EncodedKeySpec(unb64(privateKey)))
+        val wrap = Cipher.getInstance("RSA/ECB/OAEPPadding").apply {
+            init(Cipher.DECRYPT_MODE, private, OAEPParameterSpec("SHA-256","MGF1",MGF1ParameterSpec.SHA256,PSource.PSpecified.DEFAULT))
+        }
+        val key = wrap.doFinal(unb64(envelope.getString("key")))
+        val bytes = try {
+            require(key.size == 32)
+            Cipher.getInstance("AES/GCM/NoPadding").run {
+                init(Cipher.DECRYPT_MODE,SecretKeySpec(key,"AES"),GCMParameterSpec(128,unb64(envelope.getString("iv"))))
+                updateAAD(id.toByteArray(Charsets.UTF_8))
+                doFinal(unb64(envelope.getString("data")))
+            }
+        } finally { key.fill(0) }
+        val url = bytes.toString(Charsets.UTF_8)
+        bytes.fill(0)
+        val parsed = URI(url)
+        val host = parsed.host?.lowercase() ?: error("Host invalide")
+        require(url.length <= 2048 && parsed.scheme == "https" && parsed.userInfo == null && parsed.fragment == null &&
+            '.' in host && !host.matches(Regex("[0-9.]+")) && !listOf(".localhost",".local",".internal").any { host.trimEnd('.').endsWith(it) })
+        return url
+    }
+}
+
+private data class RemoteReply(val status: Int, val body: JSONObject)
+private suspend fun request(identity: RemoteIdentity, action: String, fill: JSONObject.() -> Unit): RemoteReply? =
+    withContext(Dispatchers.IO) {
+        val body = JSONObject().put("id",identity.id).put("token",identity.token).put("action",action).apply(fill)
+        try {
+            val connection = URL("https://vyro-player.app/api/remote-device").openConnection() as HttpURLConnection
+            try {
+                connection.requestMethod = "POST"
+                connection.instanceFollowRedirects = false
+                connection.connectTimeout = 6_000
+                connection.readTimeout = 8_000
+                connection.doOutput = true
+                connection.setRequestProperty("Content-Type","application/json")
+                val bytes = body.toString().toByteArray(Charsets.UTF_8)
+                if (bytes.size > 400_000) return@withContext null
+                connection.setFixedLengthStreamingMode(bytes.size)
+                connection.outputStream.use { it.write(bytes) }
+                val status = connection.responseCode
+                val result = if (status in 200..299) connection.inputStream.use { JSONObject(readControlResponse(it,400_000)) }
+                    else JSONObject()
+                RemoteReply(status,result)
+            } finally { connection.disconnect() }
+        } catch (_: java.io.IOException) { null }
+          catch (_: org.json.JSONException) { null }
+    }
+
+internal data class RemoteCatalogInput(
+    val profile: UserProfile, val allProfiles: List<UserProfile>, val binding: TvProfileBinding?,
+    val catalog: Catalog?, val custom: PlaylistCustomization,
+) {
+    fun encode(vault: CredentialVault): JSONObject {
+        val playlists = profile.playlists.take(40).map {
+            val id = vault.playlistId(it)
+            JSONObject().put("id",tvPlaylistReference(it)).put("name",it.profileName.trim().take(80).ifEmpty { "Playlist" })
+                .put("kind",if (it is XtreamSource) "xc" else "m3u")
+                .put("editable",!BuildConfig.BETA_ACCESS_ENABLED && allProfiles.none { other ->
+                    other.id != profile.id && other.playlists.any { source -> vault.playlistId(source) == id }
+                })
+        }
+        val categories = catalog?.categories.orEmpty()
+        val validCategories = categories.asSequence().filter { stable.matches(it.storageKey()) }.distinctBy { it.storageKey() }.take(501).toList()
+        val visible = custom.visibleCategoryKeys
+        val groupsValid = custom.groups.size <= 80 && custom.groups.all { groupId.matches(it.id) &&
+            it.name.isNotBlank() && it.name.length <= 80 && it.channelIds.size <= 2000 && it.channelIds.all(stable::matches) }
+        val complete = binding != null && catalog != null && groupsValid && categories.size == validCategories.size &&
+            validCategories.size <= 500 && (visible == null || visible.all { key -> validCategories.any { it.storageKey() == key } })
+        val groups = if (complete) JSONArray(custom.groups.map { g -> JSONObject()
+            .put("id",g.id).put("name",g.name).put("pinned",g.pinned).put("channels",JSONArray(g.channelIds)) }) else JSONArray()
+        val layout = JSONObject().put("visible",if (complete) visible?.sorted()?.let(::JSONArray) ?: JSONObject.NULL else JSONObject.NULL)
+            .put("groups",groups)
+        val fits = layout.toString().toByteArray(Charsets.UTF_8).size <= 140_000
+        val channels = catalog?.items.orEmpty().asSequence().filter { it.kind == ContentKind.LIVE && stable.matches(it.id) }
+            .distinctBy { it.id }.take(700).map { JSONObject().put("id",it.id).put("name",it.title.trim().take(100).ifEmpty { "Chaîne" }) }.toList()
+        val result = JSONObject().put("active",binding?.playlist ?: JSONObject.NULL)
+            .put("playlists",JSONArray(playlists))
+            .put("categories",JSONArray(validCategories.take(500).map {
+                JSONObject().put("id",it.storageKey()).put("name",it.name.trim().take(100).ifEmpty { "Catégorie" })
+            })).put("channels",JSONArray(channels))
+            .put("layout",if (binding == null) JSONObject.NULL else if (fits) layout else JSONObject().put("visible",JSONObject.NULL).put("groups",JSONArray()))
+            .put("layoutComplete",complete && fits)
+        return result.put("context",hash(result.toString()))
+    }
+}
