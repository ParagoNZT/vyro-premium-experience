+    internal fun persistRemoteIdentity(name: String, value: String) {
+        check(preferences.edit().putString("$KEY_INTEGRATION_PREFIX$name",encrypt(value)).commit())
+    }
+
+    /** Commit a source and its retry receipt together; do not move credentials between profiles. */
+    internal fun applyRemotePlaylist(profileId: String, target: String?, name: String, url: String?, receipt: String, job: String): Boolean {
+        val profiles = loadStoredProfiles()
+        val profile = profiles.firstOrNull { it.id == profileId } ?: return false
+        val existing = profile.playlists.firstOrNull { tvPlaylistReference(it) == target }
+        if (target != null && existing == null) return false
+        val oldKey = existing?.let(::playlistId)
+        if (oldKey != null && profiles.any { it.id != profileId && it.playlists.any { source -> playlistId(source) == oldKey } }) return false
+        val source = when (existing) {
+            is XtreamSource -> if (url == null) existing.copy(profileName=name) else return false
+            is M3uSource -> existing.copy(profileName=name,playlistUrl=url ?: existing.playlistUrl,
+                epgUrl=existing.epgUrl.takeIf { url == null || url == existing.playlistUrl })
+            null -> M3uSource(name,url ?: return false)
+        }
+        val key = playlistId(source)
+        if (oldKey != key && profiles.any { it.playlists.any { other -> playlistId(other) == key } }) return false
+        if (target == null && profile.playlists.size >= 40) return false
+        val sources = if (existing == null) profile.playlists + source else profile.playlists.map { if (playlistId(it) == oldKey) source else it }
+        val selected = if (profile.activePlaylistId == null || profile.activePlaylistId == oldKey) key else profile.activePlaylistId
+        val updated = profiles.map { if (it.id == profileId) it.copy(playlists=sources,activePlaylistId=selected) else it }
+        return writeProfiles(updated,preferences.getString(KEY_ACTIVE_USER_PROFILE,null),listOf(source),receipt to job)
+    }
