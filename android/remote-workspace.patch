+@Composable
+internal fun rememberRemoteWorkspace(
+    vault: CredentialVault, settings: SettingsStore, snapshot: RemoteCatalogInput?,
+    profileTransfer: TvProfileTransfer, customization: PlaylistCustomizationStore,
+    isTv: Boolean, profileUnlocked: Boolean, onRestored: () -> Unit, onPlaylistChanged: () -> Unit,
+): TvSettingsUi {
+    val lifecycle = LocalLifecycleOwner.current.lifecycle
+    val scope = rememberCoroutineScope()
+    val profileId = snapshot?.profile?.id
+    val current by rememberUpdatedState(snapshot)
+    val unlocked by rememberUpdatedState(profileUnlocked)
+    val restore by rememberUpdatedState(onRestored)
+    val reload by rememberUpdatedState(onPlaylistChanged)
+    var identity by remember(profileId) { mutableStateOf<RemoteIdentity?>(null) }
+    var code by remember(profileId) { mutableStateOf<String?>(null) }
+    var expires by remember(profileId) { mutableLongStateOf(0L) }
+    var linked by remember(profileId) { mutableStateOf(false) }
+    var busy by remember(profileId) { mutableStateOf(false) }
+    var message by remember(profileId) { mutableStateOf<String?>(null) }
+    var privateMessages by remember(profileId) { mutableStateOf(emptyList<BetaInboxMessage>()) }
+    var lastReceipt by remember(profileId) { mutableStateOf<Pair<String, JSONObject>?>(null) }
+
+    LaunchedEffect(profileId) {
+        identity = profileId?.let { withContext(Dispatchers.IO) { runCatching { RemoteIdentity.load(vault,it) }.getOrNull() } }
+    }
+    LaunchedEffect(code,expires) {
+        if (code != null) {
+            delay((expires-SystemClock.elapsedRealtime()).coerceAtLeast(0))
+            code = null
+        }
+    }
+    LaunchedEffect(lifecycle,identity,code,profileUnlocked) {
+        val registered = identity ?: return@LaunchedEffect
+        lifecycle.repeatOnLifecycle(Lifecycle.State.STARTED) {
+            while (true) {
+                val active = current?.takeIf { unlocked && it.profile.id == profileId }
+                val manifest = active?.let { withContext(Dispatchers.Default) { it.encode(vault) } }
+                val reply = request(registered,"poll") {
+                    put("catalog",manifest ?: JSONObject.NULL)
+                    if (!BuildConfig.BETA_ACCESS_ENABLED && manifest != null) put("inbox",true)
+                }
+                if (reply?.status == 200) {
+                    linked = reply.body.optBoolean("linked")
+                    if (!BuildConfig.BETA_ACCESS_ENABLED && unlocked && current?.profile?.id == profileId) {
+                        val items = reply.body.optJSONArray("messages")
+                        if (!linked) privateMessages = emptyList()
+                        else if (items != null) privateMessages = (0 until minOf(items.length(),25)).mapNotNull { index ->
+                                val row = items.optJSONObject(index) ?: return@mapNotNull null
+                                val id = row.optString("id")
+                                if (runCatching { UUID.fromString(id).toString() == id }.getOrDefault(false)) {
+                                    BetaInboxMessage(id,row.optString("title").take(100),row.optString("body").take(1000),
+                                        row.optString("createdAt"),row.optBoolean("read"),row.optString("sender").take(80).ifBlank { "Équipe VYRO" })
+                                } else null
+                            }
+                    }
+                    if (linked && code != null) { code = null; message = null }
+                    val job = reply.body.optJSONObject("job")
+                    if (job != null && active != null && unlocked && current?.profile?.id == profileId) {
+                        val id = job.getString("id")
+                        val latest = current ?: active
+                        val ack = lastReceipt?.takeIf { it.first == id }?.second ?: try {
+                            val fresh = withContext(Dispatchers.Default) { latest.encode(vault) }
+                            if (!unlocked || current !== latest) null else
+                                runRemoteJob(registered, job, fresh, latest, settings, vault, profileTransfer, customization, restore, reload)
+                        } catch (e: CancellationException) { throw e }
+                          catch (_: Exception) { JSONObject().put("ok",false) }
+                        if (ack != null) {
+                            // Keep the receipt in memory if the network drops after applying a command.
+                            lastReceipt = id to ack
+                            if (request(registered,"complete") { put("jobId",id); ack.keys().forEach { put(it,ack.get(it)) } }?.status == 200)
+                                lastReceipt = null
+                        }
+                    }
+                }
+                delay(if (code != null) 3000 else if (linked) 12000 else 45000)
+            }
+        }
+    }
+
+    return TvSettingsUi(linked,code,busy,message,qr = true,
+        privateMessages = if (profileUnlocked && linked) privateMessages else emptyList(),
+        messageReceipt = { id, dismiss ->
+            val local = identity
+            if (local != null && unlocked && linked && privateMessages.any { it.id == id }) scope.launch {
+                if (request(local,"message-receipt") {
+                    put("messageId",id)
+                    put("receipt",if (dismiss) "dismiss" else "read")
+                }?.body?.optBoolean("ok") == true && unlocked && current?.profile?.id == profileId) {
+                    privateMessages = if (dismiss) privateMessages.filterNot { it.id == id }
+                        else privateMessages.map { if (it.id == id) it.copy(isRead=true) else it }
+                }
+            }
+        }, requestCode = {
+        if (!busy && profileId != null && unlocked) scope.launch {
+            busy = true; message = null
+            try {
+                val local = withContext(Dispatchers.IO) { checkNotNull(RemoteIdentity.load(vault,profileId,create=true)) }
+                val reply = request(local,"pair") {
+                    put("name",(Build.MANUFACTURER+" "+Build.MODEL).trim().take(80).ifEmpty { "Android" })
+                    put("kind",if (isTv) "tv" else "mobile")
+                    put("edition",if (BuildConfig.BETA_ACCESS_ENABLED) "show-plus" else "vyro")
+                    put("publicKey",local.publicKey)
+                }
+                if (current?.profile?.id != profileId || !unlocked) return@launch
+                identity = local
+                val proof = reply?.body?.optString("proof")?.takeIf(proofFormat::matches)
+                if (reply?.status == 200 && proof != null) {
+                    expires = SystemClock.elapsedRealtime()+300_000
+                    code = proof
+                } else message = if (reply?.status == 409) "Appareil déjà associé à un compte VYRO."
+                    else "Impossible de créer le QR code. Réessayez dans quelques instants."
+            } catch (e: CancellationException) { throw e }
+              catch (_: Exception) { message = "Impossible de créer le QR code." }
+            finally { busy = false }
+        }
+    })
+}
