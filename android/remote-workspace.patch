+
+@RunWith(AndroidJUnit4::class)
+class RemoteWorkspaceTest {
+    @Test fun encryptedPlaylistLayoutAndRestorePersistOnAndroid() = runBlocking {
+        val base = InstrumentationRegistry.getInstrumentation().targetContext
+        val nonce = UUID.randomUUID()
+        fun isolated(side: String): Context = object : ContextWrapper(base) {
+            override fun getApplicationContext(): Context = this
+            override fun getSharedPreferences(name: String, mode: Int) =
+                super.getSharedPreferences("remote_test_${nonce}_${side}_$name",mode)
+        }
+        val tv = stores(isolated("tv"))
+        val phone = stores(isolated("phone"))
+        val source = M3uSource("Original","https://example.com/demo.m3u?token=fictitious")
+        val envelope = seal(tv.identity,source.playlistUrl)
+        val empty = tv.snapshot(null,null)
+        assertTrue(tv.run("playlist",empty,JSONObject().put("playlist",JSONObject.NULL).put("name","Original").put("sealed",envelope)).getBoolean("ok"))
+        assertEquals(source,CredentialVault(tv.context).activeProfile()?.playlists?.single())
+        assertTrue(runCatching { phone.identity.open(envelope) }.isFailure)
+        val catalog = Catalog(listOf(Category("42","Infos",ContentKind.LIVE)),listOf(CatalogItem("live:12","Fiction",ContentKind.LIVE,"42")))
+        val bound = tv.binding(source)
+        val layout = JSONObject().put("visible",JSONArray(listOf("LIVE:42"))).put("groups",JSONArray(listOf(
+            JSONObject().put("id","group-"+UUID.randomUUID()).put("name","Infos").put("pinned",true)
+                .put("channels",JSONArray(listOf("live:12")))
+        )))
+        tv.favorites.toggle(bound.scope,"live:12")
+        tv.history.save(bound.scope,PlaybackProgress("movie:4",27_000,120_000,42_000))
+        assertTrue(tv.run("layout",tv.snapshot(bound,catalog),JSONObject().put("playlist",bound.playlist).put("layout",layout)).getBoolean("ok"))
+        assertEquals("Infos",tv.custom.load(bound.scope).groups.single().name)
+        assertTrue("live:12" in tv.favorites.ids(bound.scope))
+        tv.settings.save(tv.settings.load().copy(theme=AppThemeChoice.CYAN))
+        val capture = tv.run("backup",tv.snapshot(bound,catalog),JSONObject().put("playlist",bound.playlist))
+        assertTrue(capture.getBoolean("ok"))
+        assertFalse(capture.toString().contains("token=fictitious"))
+        val restore = JSONObject().put("settings",capture.getJSONObject("settings")).put("profile",capture.getJSONObject("profile"))
+        val mismatched = phone.binding(M3uSource("Autre","https://example.com/other.m3u"))
+        assertFalse(phone.run("restore",phone.snapshot(mismatched,catalog),restore).getBoolean("ok"))
+        phone.vault.addPlaylist(phone.profileId,source)
+        val target = phone.binding(source)
+        assertTrue(phone.run("restore",phone.snapshot(target,catalog),restore).getBoolean("ok"))
+        assertEquals(AppThemeChoice.CYAN,phone.settings.load().theme)
+        assertTrue("live:12" in FavoriteStore(phone.context).ids(target.scope))
+        assertEquals("Infos",PlaylistCustomizationStore(phone.context).load(target.scope).groups.single().name)
+        assertEquals(27_000L,PlaybackHistoryStore(phone.context).load(target.scope)["movie:4"]?.positionMillis)
+    }
+
+    private class Stores(val context: Context) {
+        val vault = CredentialVault(context)
+        val profileId = vault.createProfile("Profil d’essai",0).id
+        val identity = checkNotNull(RemoteIdentity.load(vault,profileId,true))
+        val settings = SettingsStore(context).also { it.useProfile(profileId) }
+        val favorites = FavoriteStore(context)
+        val history = PlaybackHistoryStore(context)
+        val custom = PlaylistCustomizationStore(context)
+        private val transfer = TvProfileTransfer(context,favorites,WatchlistStore(context),history,custom)
+        fun binding(source: PlaylistSource) = TvProfileBinding("$profileId:${vault.playlistId(source)}",tvPlaylistReference(source),tvViewerReference(profileId))
+        fun snapshot(binding: TvProfileBinding?,catalog: Catalog?) = RemoteCatalogInput(
+            checkNotNull(vault.activeProfile()),vault.loadProfiles(),binding,catalog,binding?.let { custom.load(it.scope) } ?: PlaylistCustomization())
+        suspend fun run(kind: String, data: RemoteCatalogInput, payload: JSONObject): JSONObject {
+            val manifest = data.encode(vault)
+            return checkNotNull(runRemoteJob(identity,JSONObject().put("id",UUID.randomUUID().toString()).put("kind",kind)
+                .put("context",manifest.getString("context")).put("payload",payload),manifest,data,
+                settings,vault,transfer,custom,{},{ }))
+        }
+    }
+    private fun stores(context: Context) = Stores(context)
+    private fun seal(identity: RemoteIdentity, url: String): JSONObject {
+        val random = SecureRandom()
+        val key = ByteArray(32).also(random::nextBytes)
+        val iv = ByteArray(12).also(random::nextBytes)
+        val data = Cipher.getInstance("AES/GCM/NoPadding").run {
+            init(Cipher.ENCRYPT_MODE,SecretKeySpec(key,"AES"),GCMParameterSpec(128,iv))
+            updateAAD(identity.id.toByteArray(Charsets.UTF_8))
+            doFinal(url.toByteArray(Charsets.UTF_8))
+        }
+        val publicKey = KeyFactory.getInstance("RSA").generatePublic(X509EncodedKeySpec(Base64.decode(identity.publicKey,Base64.NO_WRAP)))
+        val encrypted = Cipher.getInstance("RSA/ECB/OAEPPadding").run {
+            init(Cipher.ENCRYPT_MODE,publicKey,OAEPParameterSpec("SHA-256","MGF1",MGF1ParameterSpec.SHA256,PSource.PSpecified.DEFAULT))
+            doFinal(key)
+        }
+        fun b64(bytes: ByteArray) = Base64.encodeToString(bytes,Base64.NO_WRAP)
+        return JSONObject().put("key",b64(encrypted)).put("iv",b64(iv)).put("data",b64(data))
+    }
