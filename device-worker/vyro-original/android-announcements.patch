+package com.vyro.tv
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.platform.LocalContext
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.compose.LocalLifecycleOwner
+import androidx.lifecycle.repeatOnLifecycle
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.time.Instant
+
+private const val FeedUrl = "https://vyro-player.app/api/vyro-announcements"
+private val announcementId = Regex("[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}")
+private data class Announcement(val message: BetaInboxMessage, val expiresAt: Instant)
+
+private suspend fun readVyroAnnouncements(): List<Announcement>? = withContext(Dispatchers.IO) {
+    try {
+        val connection = URL(FeedUrl).openConnection() as HttpURLConnection
+        try {
+            connection.instanceFollowRedirects = false
+            connection.connectTimeout = 5_000
+            connection.readTimeout = 5_000
+            connection.setRequestProperty("Accept", "application/json")
+            if (connection.responseCode != 200) return@withContext null
+            val chars = CharArray(65_537)
+            val length = connection.inputStream.bufferedReader().use { input ->
+                var used = 0
+                while (used < chars.size) {
+                    val count = input.read(chars, used, chars.size - used)
+                    if (count < 0) break
+                    used += count
+                }
+                used
+            }
+            if (length > 65_536) return@withContext null
+            val values = JSONObject(String(chars, 0, length)).getJSONArray("announcements")
+            buildList {
+                for (i in 0 until minOf(values.length(), 20)) {
+                    val row = values.optJSONObject(i) ?: continue
+                    val id = row.optString("id")
+                    if (!announcementId.matches(id)) continue
+                    val expires = runCatching { Instant.parse(row.getString("expiresAt")) }.getOrNull() ?: continue
+                    val title = row.optString("title").take(100).trim()
+                    val body = row.optString("body").take(1000).trim()
+                    if (title.isEmpty() || body.isEmpty()) continue
+                    add(Announcement(BetaInboxMessage(id, title, body, row.optString("createdAt"), false, "VYRO"), expires))
+                }
+            }
+        } finally { connection.disconnect() }
+    } catch (cancelled: CancellationException) { throw cancelled }
+    catch (_: Exception) { null }
+}
+
+/** The official app uses its own feed; no SHOW+ credentials or routes are involved. */
+@Composable
+internal fun VyroAnnouncementsGate(content: @Composable (
+    List<BetaInboxMessage>, ShowInboxAlerts, (List<String>) -> Unit, (String) -> Unit, (String) -> Unit, () -> Unit
+) -> Unit) {
+    val context = LocalContext.current
+    val owner = LocalLifecycleOwner.current
+    val prefs = remember(context) { context.getSharedPreferences("vyro_announcements_v1", 0) }
+    var refresh by remember { mutableIntStateOf(0) }
+    var source by remember { mutableStateOf(emptyList<Announcement>()) }
+    var now by remember { mutableStateOf(Instant.now()) }
+    var read by remember(prefs) { mutableStateOf(prefs.getStringSet("read", emptySet()).orEmpty().toSet()) }
+    var hidden by remember(prefs) { mutableStateOf(prefs.getStringSet("hidden", emptySet()).orEmpty().toSet()) }
+    var seen by remember(prefs) { mutableStateOf(prefs.getStringSet("seen", emptySet()).orEmpty().toSet()) }
+    LaunchedEffect(owner, refresh) {
+        owner.lifecycle.repeatOnLifecycle(Lifecycle.State.STARTED) {
+            while (true) {
+                readVyroAnnouncements()?.let { source = it }
+                now = Instant.now()
+                delay(60_000)
+            }
+        }
+    }
+    val inbox = remember(source,now,read,hidden) {
+        source.filter { it.expiresAt.isAfter(now) && it.message.id !in hidden }
+            .map { it.message.copy(isRead = it.message.id in read) }
+    }
+    val pending = remember(inbox,seen) { inbox.filterNot { it.isRead || it.id in seen } }
+    fun retain(set: Set<String>, items: Collection<String>) = (set + items).toList().takeLast(200).toSet()
+    content(inbox, ShowInboxAlerts(pending), { ids ->
+        seen = retain(seen, ids)
+        prefs.edit().putStringSet("seen", seen).apply()
+    }, { id ->
+        read = retain(read, listOf(id))
+        prefs.edit().putStringSet("read", read).apply()
+    }, { id ->
+        hidden = retain(hidden, listOf(id))
+        prefs.edit().putStringSet("hidden", hidden).apply()
+    }, { refresh++ })
+}
