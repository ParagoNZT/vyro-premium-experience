+package com.vyro.tv
+
+import android.content.Context
+import androidx.compose.runtime.staticCompositionLocalOf
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+
+internal data class PartnerCommand(val id: String, val kind: String)
+internal data class PartnerControl(
+    val commands: List<PartnerCommand>,
+    val complete: suspend (String, Boolean) -> Unit,
+)
+internal val LocalPartnerControl = staticCompositionLocalOf<PartnerControl?> { null }
+
+private val commandId = Regex("[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}")
+
+internal fun partnerPost(context: Context, path: String, extra: JSONObject = JSONObject()): JSONObject {
+    val identity = ShowInstallationManager.get(context).identity()
+    return showPost(context, path, extra.put("code", identity.token).put("deviceId", identity.deviceId))
+}
+
+internal suspend fun readPartnerCommands(context: Context): List<PartnerCommand>? = withContext(Dispatchers.IO) {
+    try {
+        val response = partnerPost(context, "/v1/show/partner-control")
+        val array = response.optJSONArray("commands")
+        val preferences = context.getSharedPreferences("partner_command_results", Context.MODE_PRIVATE)
+        buildList {
+            for (index in 0 until minOf(array?.length() ?: 0, 8)) {
+                val row = array?.optJSONObject(index) ?: continue
+                val id = row.optString("id")
+                val kind = row.optString("kind")
+                if (!commandId.matches(id) || kind !in setOf("playlist", "epg")) continue
+                val previous = preferences.getString(id, null)
+                if (previous != null) sendPartnerReceipt(context, id, previous)
+                else add(PartnerCommand(id, kind))
+            }
+        }
+    } catch (cancelled: CancellationException) { throw cancelled }
+    catch (_: Exception) { null }
+}
+
+private fun sendPartnerReceipt(context: Context, id: String, outcome: String) {
+    val ack = JSONObject().put("id", id).put("outcome", outcome)
+    val result = partnerPost(context, "/v1/show/partner-control", JSONObject().put("ack", ack))
+    if (result.optBoolean("ok"))
+        context.getSharedPreferences("partner_command_results", Context.MODE_PRIVATE).edit().remove(id).apply()
+}
+
+internal suspend fun completePartnerCommand(context: Context, id: String, success: Boolean) = withContext(Dispatchers.IO) {
+    val outcome = if (success) "applied" else "failed"
+    context.getSharedPreferences("partner_command_results", Context.MODE_PRIVATE)
+        .edit().putString(id, outcome).apply()
+    try { sendPartnerReceipt(context, id, outcome) }
+    catch (cancelled: CancellationException) { throw cancelled }
+    catch (_: Exception) { /* The next authenticated poll retries the receipt. */ }
+}
